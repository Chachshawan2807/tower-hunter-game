{
  "name": "tower-hunter-game",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:strict": "eslint src --max-warnings 0",
    "validate": "node scripts/check-package-json.mjs && tsx scripts/validate.ts && tsx scripts/validate-architecture.ts && npm run typecheck && npm run lint",
    "seed": "tsx scripts/seed.ts",
    "db:check": "tsx scripts/db-check.ts",
    "dev": "node scripts/dev.mjs",
    "dev:3d": "node scripts/dev.mjs",
    "dev:2d": "node scripts/dev.mjs --2d",
    "dev:web": "vite",
    "dev:web:3d": "vite --mode render3d",
    "dev:api": "tsx watch src/server/index.ts",
    "build": "vite build",
    "generate:audio": "node scripts/generateAudioAssets.mjs",
    "generate:sprites": "node scripts/generateCharacterSheets.mjs",
    "generate:battle-models": "node scripts/generateBattleFighterGlbs.mjs",
    "export:nav": "node scripts/buildNavButtonSvgs.mjs && node scripts/buildBagIconSvg.mjs && node scripts/buildShopIconSvg.mjs",
    "export:equip-slots": "node scripts/buildEquipmentSlotSvgs.mjs",
    "export:equip-items": "node scripts/buildEquipmentItemSvgs.mjs",
    "split:equipment-sheet": "node scripts/splitEquipmentSheet.mjs",
    "export:icons": "node scripts/buildNavButtonSvgs.mjs && node scripts/buildBagIconSvg.mjs && node scripts/buildShopIconSvg.mjs && node scripts/buildBookIconSvg.mjs && node scripts/buildEquipmentSlotSvgs.mjs && node scripts/buildEquipmentItemSvgs.mjs && node scripts/exportImperialIcons.mjs && node scripts/exportSkillIcons.mjs && node scripts/buildGoldIconSvg.mjs && py -3 scripts/export-mailbox-icon.py",
    "export:mailbox-icon": "py -3 scripts/export-mailbox-icon.py",
    "import:skill-icons": "node scripts/importSkillIconSheet.mjs --dark-sheet",
    "export:hero": "node scripts/buildHeroPortraitSvg.mjs",
    "split:hero-turnaround": "node scripts/splitHeroTurnaround.mjs",
    "fetch:audio": "node scripts/fetchStudioAudio.mjs",
    "preview": "vite preview",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "dotenv": "^17.4.2",
    "hono": "^4.7.4",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/eslint-plugin": "^0.1.2",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.6.0",
    "eslint": "^10.7.0",
    "ffmpeg-static": "^5.3.0",
    "mcp-game-helper": "github:xhulz/mcp-game-helper",
    "sharp": "^0.35.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
