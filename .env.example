# Copy to .env — PostgreSQL connection (local or hosted; pg driver only, not Supabase SDK)
# Example hosted: Supabase → Project Settings → Database → Connection string (URI, Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
PORT=3000

# Optional (dev only): 3D calibration preview — or use npm run dev:web:3d / ?render3d=1
# VITE_RENDER_3D_DEV=1
# Optional: battle arena WebGL (dev via render3d flags, or set for production)
# VITE_BATTLE_3D=1
